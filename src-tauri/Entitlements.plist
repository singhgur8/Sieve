<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime, not sandboxed: Sieve reads RAW folders and writes XMP sidecars and
         exports wherever the user points it, and reads Adobe Camera Raw profiles in place. -->
    <!-- The bundled Homebrew dylibs (LibRaw, libjpeg-turbo, lcms2, libomp) are ad-hoc signed
         without a Team ID; library validation would reject them under an ad-hoc signature. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
