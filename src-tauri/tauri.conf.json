{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sieve",
  "version": "0.1.0",
  "identifier": "com.sieve.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && bash scripts/fetch-models.sh --culling",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sieve",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost sieve: http://sieve.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost sieve: http://sieve.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "copyright": "Copyright © 2026 Gurjot Singh",
    "shortDescription": "Local RAW culling, editing and export",
    "resources": {
      "target/sieve-stage/models/": "models/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "target/sieve-stage/Frameworks/libjpeg.8.dylib",
        "target/sieve-stage/Frameworks/liblcms2.2.dylib",
        "target/sieve-stage/Frameworks/libomp.dylib",
        "target/sieve-stage/Frameworks/libraw_r.dylib",
        "target/sieve-stage/Frameworks/libturbojpeg.dylib"
      ],
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
